name: mam-audiofinder-transmission
services:
  mam-audiofinder:
    build:
      context: /tmp/workspace/odrusso/mam-audiofinder-transmission
      dockerfile: Dockerfile
    container_name: mam-audiofinder
    environment:
      MAM_COOKIE: ""
      TRANSMISSION_PASS: ""
      TRANSMISSION_URL: http://transmission:9091/transmission/rpc
      TRANSMISSION_USER: ""
    networks:
      default: null
    ports:
      - mode: ingress
        target: 8080
        published: "8080"
        protocol: tcp
    restart: unless-stopped
    volumes:
      - type: bind
        source: /path/to/appdata-for-db
        target: /data
        bind:
          create_host_path: true
      - type: bind
        source: /path/to/audiobook-media-root
        target: /storage
        bind:
          create_host_path: true
      - type: bind
        source: /path/to/ebook-library
        target: /ebooks
        bind:
          create_host_path: true
networks:
  default:
    name: mam-audiofinder-transmission_default
